{
  "schema_version": "stage-schema.v1",
  "description": "DSH 专属版本的阶段门禁 schema（单一真相源）。[DEPRECATED] 产出物要求（sections/require_verify/permission/tools）已迁入工作流插件包 .harness/workflows/{name}/workflow.yaml（workflow-plugin 机制，见 docs/workflow-plugin-spec.md）；本文件仅保留供 DSH 运行时消费，不再作为通用层 gate 的数据源。",
  "verify_config": "knowledge/verify.config.json",
  "verify_config_schema": "verify.config.v2",
  "stages": {
    "designing": {
      "output": "design.md",
      "sections": [["## Summary for downstream"], ["## Decision Log"]],
      "require_verify": false,
      "gate": "user_approval",
      "permission": "read-only",
      "tools": "read+bash"
    },
    "task-planning": {
      "output": "task-plan.md",
      "sections": [["## Summary for downstream"], ["## Decision Log"]],
      "require_verify": false,
      "gate": "user_approval",
      "permission": "read-only",
      "tools": "read+bash"
    },
    "implementing": {
      "output": "changes.md",
      "sections": [["## Summary for downstream"]],
      "require_verify": false,
      "gate": "none",
      "permission": "workspace-write",
      "tools": "code-mode"
    },
    "testing": {
      "output": "test-report.md",
      "sections": [
        ["## Summary for downstream"],
        ["## 完整性声明", "## Anti-Cherry-Pick Declaration"]
      ],
      "require_verify": true,
      "gate": "user_approval",
      "on_fail": "implementing",
      "permission": "workspace-write",
      "tools": "code-mode"
    },
    "reviewing": {
      "output": "review-report.md",
      "sections": [["## Summary for downstream"], ["## Anti-Cherry-Pick Declaration"]],
      "require_verify": true,
      "gate": "user_approval",
      "on_fail": "implementing",
      "permission": "read-only",
      "tools": "read+bash"
    },
    "reflecting": {
      "output": "lessons-draft.md",
      "sections": [],
      "require_verify": false,
      "gate": "none",
      "permission": "read-only",
      "tools": "read+bash"
    },
    "git-operations": {
      "output": "changes.md",
      "sections": [],
      "require_verify": false,
      "gate": "user_approval",
      "permission": "workspace-write",
      "tools": "bash"
    }
  },
  "json_summary_spec": {
    "description": "每个阶段子代理除写 markdown 产出物外，必须返回以下 JSON 摘要，由编排器按 schema 校验：",
    "fields": {
      "stage": "阶段名",
      "output_file": "实际写出的产出物相对路径（.harness/workspace/{task-id}/xxx.md）",
      "sections_ok": "产出物包含全部必含区块（true/false）——false 时编排器视为阶段失败",
      "verify_evidence": "testing/reviewing 阶段的验证证据路径或 null（其余阶段填 null）",
      "notes": "一句话说明（决策要点/遗留风险），可选"
    }
  }
}
